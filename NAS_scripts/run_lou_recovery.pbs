#!/bin/bash
#PBS -N tide_r2_fix
#PBS -q e_normal
#PBS -l select=1:ncpus=4:mem=32gb:model=cas_end
#PBS -l walltime=02:00:00
#PBS -J 1-3
#PBS -o /home4/tvnguy18/tide_models_analysis_global/logs/
#PBS -e /home4/tvnguy18/tide_models_analysis_global/logs/

# Map array index to the original failed worker IDs
FAILED_WORKERS=(5 6 7)
ORIGINAL_WID=${FAILED_WORKERS[$((PBS_ARRAY_INDEX - 1))]}
TOTAL_WORKERS=32
PROJECT_DIR="/home4/tvnguy18/tide_models_analysis_global"

cd "$PROJECT_DIR"
source /usr/share/modules/init/bash
module load python3/3.11.5

python3 NAS_scripts/run_worker.py \
    --worker-id "$ORIGINAL_WID" \
    --total-workers "$TOTAL_WORKERS"
