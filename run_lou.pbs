#!/bin/bash
#PBS -N tide_r2
#PBS -q e_normal
#PBS -l select=1:ncpus=4:mem=16gb:model=cas_end
#PBS -l walltime=02:00:00
#PBS -J 1-32
#PBS -o logs/
#PBS -e logs/
#PBS -m ae

TOTAL_WORKERS=32

cd "$PBS_O_WORKDIR"
source /usr/share/modules/init/bash
module load python3/3.11.5

python3 run_worker.py \
    --worker-id "$PBS_ARRAY_INDEX" \
    --total-workers "$TOTAL_WORKERS"
